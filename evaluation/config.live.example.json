{
  "schema_version": "telosieve.evaluation-config/v5",
  "mode": "kubernetes-live",
  "scenario_path": "../scenarios/benign.json",
  "certificate_path": "out/live-certificate.json",
  "ledger_path": "out/live-ledger.jsonl",
  "observation_trust_path": "observation-trust.live.example.json",
  "observation_sources": [
    {
      "executable_path": "/opt/telosieve/scripts/observation-source-client.py",
      "arguments": ["--socket", "/run/telosieve-observation-kubernetes-a/relay.sock", "--token", "/etc/telosieve/tokens/kubernetes-a.token"]
    },
    {
      "executable_path": "/opt/telosieve/scripts/observation-source-client.py",
      "arguments": ["--socket", "/run/telosieve-observation-kubernetes-b/relay.sock", "--token", "/etc/telosieve/tokens/kubernetes-b.token"]
    }
  ],
  "kubernetes": {
    "kubectl_path": "/usr/local/bin/kubectl",
    "kubeconfig_path": "/var/run/telosieve/kubeconfig",
    "context": "evaluation",
    "namespace": "telosieve-research",
    "desired_config_map": "repair-goal",
    "observed_stateful_set": "research-kv"
  }
}
